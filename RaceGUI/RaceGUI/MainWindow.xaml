<Window x:Class="RaceGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="F1 Manager 2025" Height="720" Width="1080"
        KeyDown="Window_KeyDown" KeyUp="Window_KeyUp">
    <Grid>
        <Grid Name="MainMenuGrid" Visibility="Visible">
            <Grid.Background>
                <ImageBrush ImageSource="/Images/StartScreen.png" Stretch="UniformToFill"/>
            </Grid.Background>

            <Button Name="BtnSettings" Width="60" Height="60" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="20" Click="BtnSettings_Click" Cursor="Hand" Background="Transparent" BorderBrush="Transparent">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Image Source="/Images/SettingsButton.png" Stretch="Uniform"/>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Button Name="BtnPlayGame" Width="130" Height="130" HorizontalAlignment="Center" VerticalAlignment="Center" Click="BtnPlayGame_Click" Cursor="Hand" Background="Transparent" BorderBrush="Transparent">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Image Source="/Images/StartButton.png" Stretch="Uniform"/>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <StackPanel Name="MapSelectionPanel" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="ОБЕРІТЬ КАРТУ" Foreground="White" FontWeight="Bold" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,20">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="5" ShadowDepth="3"/>
                    </TextBlock.Effect>
                </TextBlock>
                
                <StackPanel Orientation="Horizontal">
                    <Button Name="BtnMapWinter" Width="300" Height="300" Margin="20" Click="BtnMapWinter_Click" Cursor="Hand" Background="Transparent" BorderBrush="Transparent">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Image Source="/Images/ChWMap.jpg" Stretch="Uniform"/>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    
                    <Button Name="BtnMapForest" Width="300" Height="300" Margin="20" Click="BtnMapForest_Click" Cursor="Hand" Background="Transparent" BorderBrush="Transparent">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Image Source="/Images/ChFMap.jpg" Stretch="Uniform"/>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </StackPanel>

            <Border Name="SettingsPanel" Visibility="Collapsed" Background="#F22C3E50" Width="360" Height="260" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="10">
                <StackPanel Margin="25">
                    <TextBlock Text="НАЛАШТУВАННЯ ТРАСИ" Foreground="White" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                    <TextBlock Text="Кількість кіл:" Foreground="White" FontWeight="Bold" Margin="0,0,0,5"/>
                    <ComboBox Name="ComboLaps" SelectedIndex="1" Margin="0,0,0,20">
                        <ComboBoxItem Content="3 кола (Спринт)"/>
                        <ComboBoxItem Content="5 кіл (Стандартна гонка)"/>
                        <ComboBoxItem Content="15 кіл (Повна дистанція)"/>
                    </ComboBox>
                    <CheckBox Name="CheckAutoPit" Content="Авто-лімітатор швидкості на піт-лейн" IsChecked="True" Foreground="White" FontWeight="Bold" Margin="0,0,0,25"/>
                    <Button Content="Зберегти налаштування" Click="BtnCloseSettings_Click" Width="180" Padding="8" Background="#27AE60" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Name="GameScreenGrid" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Background="#2C3E50">
                <Button Name="BtnStart" Content="Старт Гонки" Width="120" Margin="10" Click="BtnStart_Click" Background="#27AE60" Foreground="White" FontWeight="Bold"/>
                <Button Name="BtnStop" Content="Пауза" Width="100" Margin="0,10,10,10" Click="BtnStop_Click" Background="#E74C3C" Foreground="White" FontWeight="Bold"/>
                <TextBlock Name="TxtStatus" Text="Статус: Очікування" VerticalAlignment="Center" Foreground="White" Margin="20,0,0,0" FontSize="16"/>
            </StackPanel>

            <Canvas Name="GameCanvas" Grid.Row="1" MouseDown="GameCanvas_MouseDown">
                <Canvas.Background>
                    <ImageBrush ImageSource="/Images/WinterMap.jpg" Stretch="Fill"/>
                </Canvas.Background>
                
                <TextBlock Name="TxtPitStatus" Text="Йде обслуговування..." FontSize="28" Foreground="Yellow" FontWeight="Bold" Canvas.Left="390" Canvas.Top="630" Visibility="Collapsed"/>
            </Canvas>
        </Grid>
    </Grid>
</Window>